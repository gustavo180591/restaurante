# ===== .env.example =====
# Copiá este archivo a .env y completá los valores marcados.

# --- Base de datos (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5474/restaurante?schema=public"

# --- Almacenamiento de archivos ---
# Opciones: disk | s3
STORAGE_DRIVER="disk"
UPLOAD_DIR="./storage/uploads"

# --- Entorno / servidor ---
NODE_ENV="development"
# PORT=5174            # opcional, usa el por defecto si no lo definís

# --- CORS (si el frontend corre en otro origen) ---
# ORIGIN="http://localhost:5173"

# --- JWT (solo servidor) ---
# Generá un secreto fuerte y pegalo acá (no uses variables VITE_ para secretos)
JWT_SECRET="6IMhS-aquNiJjR1Zr9FT_v-o3eTH0dVfe9uiFAeNV1jAO1OHxQzCt2L3cw4i9hFGSwUK51bW2MgcNZWhMZw80w"


# --- S3 (solo si STORAGE_DRIVER=s3) ---
# S3_REGION="us-east-1"
# S3_BUCKET="mi-bucket"
# S3_ACCESS_KEY_ID="REEMPLAZAR"
# S3_SECRET_ACCESS_KEY="REEMPLAZAR"

# --- Configuración de correo ---
# En desarrollo, usa una cuenta de prueba de ethereal.email
# Para producción, configura un servicio SMTP real
EMAIL_FROM="Restaurante App <noreply@restaurante.com>"

# Configuración para ethereal.email (solo desarrollo)
# No es necesario configurar nada, se usan credenciales automáticas

# Configuración para producción (ejemplo con Gmail)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASSWORD="tu-contraseña-de-app"
# SMTP_FROM="Tu Nombre <tu-email@gmail.com>"
