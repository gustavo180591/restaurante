// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------- Catálogos / básicos ----------------------

model Perfiles {
  Id_Perfil    Int        @id @default(autoincrement())
  NombrePerfil String     @db.VarChar(55)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Usuarios     Usuarios[]
}

model Fotos {
  Id_Foto   Int        @id @default(autoincrement())
  Ruta      String     @db.VarChar(255)
  Tipo      String     @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Usuarios  Usuarios[]
  Platos    Platos[]
}

model Estados {
  Id_estado  Int          @id @default(autoincrement())
  NombEstado String       @db.VarChar(100)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  TurnosMenu TurnosMenu[]
}

model Menu {
  Id_Menu    Int          @id @default(autoincrement())
  NombreMenu String       @db.VarChar(100)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Turnos     TurnosMenu[]
}

model Especialidades {
  Id_especialidad    Int                @id @default(autoincrement())
  NombreEspecialidad String             @db.VarChar(100)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  MenuEspecialidad   MenuEspecialidad[]
}

model TipoPlato {
  Id_TipoPlato     Int                @id @default(autoincrement())
  NombreTipo       String             @db.VarChar(100)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  MenuEspTipoPlato MenuEspTipoPlato[]
}

// ---------------------- Personas / usuarios ----------------------

model Personas {
  Id_Persona Int         @id @default(autoincrement())
  dni        String      @db.VarChar(15)
  nombres    String      @db.VarChar(100)
  Apellidos  String      @db.VarChar(100)
  genero     Int
  Telefono   String      @db.VarChar(15)
  email      String?     @db.VarChar(100)
  direccion  String?     @db.VarChar(255)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  Empleados  Empleados[]
  Clientes   Clientes[]
}

// ... (your existing models remain the same until Usuarios)

model Usuarios {
  Id_usuario         Int       @id @default(autoincrement())
  usuario            String    @db.VarChar(100)
  clave              String    @db.VarChar(255)
  sessionVersion     Int       @default(1)
  email              String?   @db.VarChar(255)
  activo             Boolean   @default(true)
  ultimoInicioSesion DateTime?
  intentosFallidos   Int       @default(0)
  bloqueadoHasta     DateTime?
  resetToken         String?
  resetTokenExpira   DateTime?
  emailVerificado    Boolean   @default(false)
  emailToken         String?
  emailTokenExpira   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  Id_Perfil          Int
  Id_Foto            Int?

  // Relations
  Perfil    Perfiles    @relation(fields: [Id_Perfil], references: [Id_Perfil])
  Foto      Fotos?      @relation(fields: [Id_Foto], references: [Id_Foto])
  Empleados Empleados[]
  Clientes  Clientes[]
  Sesiones  Sesiones[]

  @@unique([usuario], name: "uq_usuario")
  @@index([usuario], name: "idx_usuario")
  @@index([email], name: "idx_email")
}

model Empleados {
  Id_empleado Int      @id @default(autoincrement())
  Id_Persona  Int
  Id_usuario  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  persona Personas @relation(fields: [Id_Persona], references: [Id_Persona])
  usuario Usuarios @relation(fields: [Id_usuario], references: [Id_usuario])
}

model Clientes {
  Id_Cliente Int      @id @default(autoincrement())
  Id_Persona Int
  Id_usuario Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  persona Personas @relation(fields: [Id_Persona], references: [Id_Persona])
  usuario Usuarios @relation(fields: [Id_usuario], references: [Id_usuario])
}

model Platos {
  Id_Plato    Int      @id @default(autoincrement())
  Nombre      String   @db.VarChar(255)
  Descripcion String?  @db.Text
  Precio      Decimal  @db.Decimal(10, 2)
  Activo      Boolean  @default(true)
  Id_Foto     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  Foto Fotos? @relation(fields: [Id_Foto], references: [Id_Foto])
}

model TurnosMenu {
  Id_Turno    Int      @id @default(autoincrement())
  Nombre      String   @db.VarChar(100)
  HoraInicio  DateTime @db.Time
  HoraFin     DateTime @db.Time
  Descripcion String?  @db.VarChar(255)
  Activo      Boolean  @default(true)
  Id_Menu     Int
  Id_Estado   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  Menu               Menu               @relation(fields: [Id_Menu], references: [Id_Menu])
  Estado             Estados            @relation(fields: [Id_Estado], references: [Id_estado])
  menuEspecialidades MenuEspecialidad[]
}

model MenuEspecialidad {
  Id_MenuEspecialidad Int      @id @default(autoincrement())
  Id_Especialidad     Int
  Id_Turno            Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  Especialidad     Especialidades     @relation(fields: [Id_Especialidad], references: [Id_especialidad])
  Turno            TurnosMenu         @relation(fields: [Id_Turno], references: [Id_Turno])
  MenuEspTipoPlato MenuEspTipoPlato[]
}

model MenuEspTipoPlato {
  Id_MenuEspTipoPlato Int      @id @default(autoincrement())
  Id_MenuEspecialidad Int
  Id_TipoPlato        Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  MenuEspecialidad MenuEspecialidad @relation(fields: [Id_MenuEspecialidad], references: [Id_MenuEspecialidad])
  TipoPlato        TipoPlato        @relation(fields: [Id_TipoPlato], references: [Id_TipoPlato])
}

// ... (rest of your existing models like Sesiones and IntentosLogin)
// Add this new model for session tracking
model Sesiones {
  id        String   @id @default(uuid())
  usuarioId Int
  token     String   @db.VarChar(255)
  userAgent String?
  ip        String?
  expiraEn  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuarios @relation(fields: [usuarioId], references: [Id_usuario], onDelete: Cascade)

  @@index([usuarioId], name: "idx_sesion_usuario")
  @@index([token], name: "idx_sesion_token")
}

// ... (resto de tus modelos existentes)

// Add this model for login attempts tracking
model IntentosLogin {
  id        Int      @id @default(autoincrement())
  usuario   String   @db.VarChar(100)
  exito     Boolean
  ip        String?
  userAgent String?
  intentoEn DateTime @default(now())

  @@index([usuario], name: "idx_intentos_usuario")
  @@index([ip], name: "idx_intentos_ip")
  @@index([intentoEn], name: "idx_intentos_fecha")
}
