generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  admin
  operador
  mozo
  cliente
}

model Fotos {
  Id_Foto   Int        @id @default(autoincrement())
  Ruta      String     @db.VarChar(255)
  Tipo      String     @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Platos    Platos[]
  Usuarios  Usuarios[]
}

model Estados {
  Id_estado  Int          @id @default(autoincrement())
  NombEstado String       @db.VarChar(100)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  TurnosMenu TurnosMenu[]
}

model Menu {
  Id_Menu    Int          @id @default(autoincrement())
  NombreMenu String       @db.VarChar(100)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  TurnosMenu TurnosMenu[]
}

model Especialidades {
  Id_especialidad    Int                @id @default(autoincrement())
  NombreEspecialidad String             @db.VarChar(100)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  MenuEspecialidad   MenuEspecialidad[]
}

model TipoPlato {
  Id_TipoPlato     Int                @id @default(autoincrement())
  NombreTipo       String             @db.VarChar(100)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  MenuEspTipoPlato MenuEspTipoPlato[]
}

model Personas {
  Id_Persona Int         @id @default(autoincrement())
  dni        String      @db.VarChar(15)
  nombres    String      @db.VarChar(100)
  Apellidos  String      @db.VarChar(100)
  genero     Int
  Telefono   String      @db.VarChar(15)
  email      String?     @db.VarChar(100)
  direccion  String?     @db.VarChar(255)
  rol        Rol         @default(cliente)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  Clientes   Clientes[]
  Empleados  Empleados[]
}

model Usuarios {
  Id_usuario         Int         @id @default(autoincrement())
  usuario            String      @db.VarChar(100)
  clave              String      @db.VarChar(255)
  email              String?     @db.VarChar(255)
  activo             Boolean     @default(true)
  ultimoAcceso       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  Fotos_Id_Foto  Int?
  sessionVersion Int         @default(1)
  Cartas         Cartas[]
  Clientes       Clientes[]
  Empleados      Empleados[]
  Fotos          Fotos?      @relation(fields: [Fotos_Id_Foto], references: [Id_Foto])
}

model Empleados {
  Id_empleado         Int      @id @default(autoincrement())
  Personas_Id_Persona Int
  Usuarios_Id_usuario Int
  Personas            Personas @relation(fields: [Personas_Id_Persona], references: [Id_Persona])
  Usuarios            Usuarios @relation(fields: [Usuarios_Id_usuario], references: [Id_usuario])
}

model Clientes {
  Id_Cliente          Int      @id @default(autoincrement())
  Personas_Id_Persona Int
  Usuarios_Id_usuario Int
  Personas            Personas @relation(fields: [Personas_Id_Persona], references: [Id_Persona])
  Usuarios            Usuarios @relation(fields: [Usuarios_Id_usuario], references: [Id_usuario])
}

model Platos {
  Id_Plato                    Int                           @id @default(autoincrement())
  NombrePlato                 String                        @db.VarChar(255)
  Descripcion                 String?
  Precio                      Decimal                       @db.Decimal(10, 2)
  Activo                      Boolean                       @default(true)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  Fotos_Id_Foto               Int?
  Fotos                       Fotos?                        @relation(fields: [Fotos_Id_Foto], references: [Id_Foto])
  Platos_has_MenuEspTipoPlato Platos_has_MenuEspTipoPlato[]
}

model TurnosMenu {
  Id_Turno          Int                @id @default(autoincrement())
  HoraInicio        DateTime           @db.Time(6)
  HoraFin           DateTime           @db.Time(6)
  Nombre            String             @db.VarChar(100)
  Descripcion       String?            @db.VarChar(255)
  Activo            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  Menu_Id_Menu      Int
  Estados_Id_estado Int
  MenuEspecialidad  MenuEspecialidad[]
  Estados           Estados            @relation(fields: [Estados_Id_estado], references: [Id_estado])
  Menu              Menu               @relation(fields: [Menu_Id_Menu], references: [Id_Menu])
}

model MenuEspecialidad {
  Id_MenuEspecialidad            Int                @id @default(autoincrement())
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  Especialidades_Id_especialidad Int
  TurnosMenu_Id_Turno            Int
  MenuEspTipoPlato               MenuEspTipoPlato[]
  Especialidades                 Especialidades     @relation(fields: [Especialidades_Id_especialidad], references: [Id_especialidad])
  TurnosMenu                     TurnosMenu         @relation(fields: [TurnosMenu_Id_Turno], references: [Id_Turno])
}

model MenuEspTipoPlato {
  Id_MenuEspTipoPlato                  Int                           @id @default(autoincrement())
  MenuEspecialidad_Id_MenuEspecialidad Int
  TipoPlato_Id_TipoPlato               Int
  MenuEspecialidad                     MenuEspecialidad              @relation(fields: [MenuEspecialidad_Id_MenuEspecialidad], references: [Id_MenuEspecialidad])
  TipoPlato                            TipoPlato                     @relation(fields: [TipoPlato_Id_TipoPlato], references: [Id_TipoPlato])
  Platos_has_MenuEspTipoPlato          Platos_has_MenuEspTipoPlato[]
}

model CartaDetalle {
  idCartaDetalle                            Int                         @id @default(autoincrement())
  Platos_has_MenuEspTipoPlato_Id_PlatoCarta String
  Cartas_idCartas                           Int
  Cartas                                    Cartas                      @relation(fields: [Cartas_idCartas], references: [idCartas], onDelete: Cascade)
  Platos_has_MenuEspTipoPlato               Platos_has_MenuEspTipoPlato @relation(fields: [Platos_has_MenuEspTipoPlato_Id_PlatoCarta], references: [Id_PlatoCarta])
}

model Cartas {
  idCartas            Int            @id @default(autoincrement())
  Fecha               DateTime       @db.Date
  Estado              String         @default("activa") @db.VarChar(50)
  Notas               String?
  Total               Decimal?       @db.Decimal(12, 2)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  Usuarios_Id_usuario Int
  CartaDetalle        CartaDetalle[]
  Usuarios            Usuarios       @relation(fields: [Usuarios_Id_usuario], references: [Id_usuario])
}

model Platos_has_MenuEspTipoPlato {
  Id_PlatoCarta                        String           @id @db.VarChar(45)
  Platos_Id_Plato                      Int
  MenuEspTipoPlato_Id_MenuEspTipoPlato Int
  CartaDetalle                         CartaDetalle[]
  MenuEspTipoPlato                     MenuEspTipoPlato @relation(fields: [MenuEspTipoPlato_Id_MenuEspTipoPlato], references: [Id_MenuEspTipoPlato])
  Platos                               Platos           @relation(fields: [Platos_Id_Plato], references: [Id_Plato])
}
